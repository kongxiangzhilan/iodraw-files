<mxfile host="app.diagrams.net">
  <diagram name="跨领域技术融合机会挖掘系统架构">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 模块1 -->
        <mxCell id="m1" value="1 数据解析模块&#10;• 多源技术数据采集&#10;• 清洗、去噪与标准化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="60" y="300" width="260" height="120" as="geometry"/>
        </mxCell>

        <!-- 模块2 -->
        <mxCell id="m2" value="2 跨域技术关联抽取模块&#10;• 技术语义对齐&#10;• 跨领域关系识别" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="360" y="300" width="300" height="120" as="geometry"/>
        </mxCell>

        <!-- 模块3 -->
        <mxCell id="m3" value="3 多维度动态知识图谱构建模块&#10;• 技术—领域—时间建模&#10;• 动态更新与演化表示" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="720" y="300" width="320" height="120" as="geometry"/>
        </mxCell>

        <!-- 模块4 -->
        <mxCell id="m4" value="4 融合机会演化建模与预测模块&#10;• 时序演化建模&#10;• 技术融合趋势预测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1080" y="300" width="320" height="120" as="geometry"/>
        </mxCell>

        <!-- 模块5 -->
        <mxCell id="m5" value="5 融合机会挖掘与输出模块&#10;• 融合机会识别与排序&#10;• 标准化分析报告输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#D84315;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1440" y="300" width="320" height="120" as="geometry"/>
        </mxCell>

        <!-- 连线 -->
        <mxCell id="e1" style="endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="m1" target="m2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" style="endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="m2" target="m3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" style="endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="m3" target="m4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" style="endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="m4" target="m5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
