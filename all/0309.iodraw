<mxfile host="app.diagrams.net">
  <diagram name="OpenClaw架构">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <mxCell id="title" value="OpenClaw 系统架构" style="text;html=1;fontSize=20;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="10" width="300" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="intelligence" value="智能层&#xa;技能 | 记忆 | 心跳机制 | 多智能体" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="400" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="execution" value="执行层" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;" vertex="1" parent="1">
          <mxGeometry x="250" y="200" width="500" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="task1" value="任务1" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="80" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="task2" value="任务2" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="420" y="230" width="80" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="task3" value="任务3" style="rounded=1;fillColor=#d5e8d4;" vertex="1" parent="1">
          <mxGeometry x="540" y="230" width="80" height="40" as="geometry"/>
        </mxCell>

        <mxCell id="integration" value="集成层&#xa;WhatsApp | Telegram | Discord | Slack | iMessage | Signal" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;" vertex="1" parent="1">
          <mxGeometry x="250" y="360" width="500" height="100" as="geometry"/>
        </mxCell>

        <mxCell id="gateway" value="网关层&#xa;网关（单一 Node.js 进程）&#xa;WebSocket | HTTP接口 | 控制界面&#xa;端口18789" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;" vertex="1" parent="1">
          <mxGeometry x="250" y="500" width="500" height="120" as="geometry"/>
        </mxCell>

        <mxCell id="devices" value="终端设备&#xa;iOS | macOS | Android" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="780" y="520" width="140" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="models" value="Pi Agent 框架&#xa;Claude | GPT-4 | DeepSeek" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;" vertex="1" parent="1">
          <mxGeometry x="60" y="240" width="150" height="120" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>