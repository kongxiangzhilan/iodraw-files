    <mxCell id="step_a" value="&lt;b&gt;(a) 线性化修正&lt;/b&gt;&lt;br&gt;处理 arccos 压缩&lt;br&gt;保持 θ 线性响应" style="whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
