<mxfile host="app.diagrams.net">
  <diagram name="Angular-Distance-Discriminative-Pipeline">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="900">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- 极简入口 -->
        <mxCell id="base" value="Base Angular Distance" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#999999;" vertex="1" parent="1">
          <mxGeometry x="40" y="300" width="220" height="70" as="geometry"/>
        </mxCell>

        <!-- (a) -->
        <mxCell id="a" value="(a) Small-angle Linearization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="320" y="300" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- (b) -->
        <mxCell id="b" value="(b) Direction-aware Weighting" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
          <mxGeometry x="640" y="300" width="260" height="70" as="geometry"/>
        </mxCell>

        <!-- (c) -->
        <mxCell id="c" value="(c) Soft Angular Distance Optimization" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="960" y="300" width="300" height="70" as="geometry"/>
        </mxCell>

        <!-- (d) -->
        <mxCell id="d" value="(d) Distribution-based Discrimination" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;" vertex="1" parent="1">
          <mxGeometry x="640" y="430" width="360" height="80" as="geometry"/>
        </mxCell>

        <!-- 最终输出 -->
        <mxCell id="out" value="Semantic Consistency Assessment" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1">
          <mxGeometry x="640" y="560" width="360" height="80" as="geometry"/>
        </mxCell>

        <!-- 连线 + 数据标注 -->
        <mxCell id="e1" value="d₀" style="endArrow=block;html=1;" edge="1" parent="1" source="base" target="a">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" value="d₁" style="endArrow=block;html=1;" edge="1" parent="1" source="a" target="b">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" value="d₂" style="endArrow=block;html=1;" edge="1" parent="1" source="b" target="c">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" value="d₃ = {d₃¹ … d₃ⁿ}" style="endArrow=block;html=1;" edge="1" parent="1" source="c" target="d">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e5" value="μ , σ² , anomaly signals" style="endArrow=block;html=1;" edge="1" parent="1" source="d" target="out">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
