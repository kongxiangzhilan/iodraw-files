  <diagram id="gateway-protocol-stack" name="跨介质网关协议栈结构图">
    <mxGraphModel dx="1042" dy="569" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="827" pageHeight="1169" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="layer_app" value="&lt;b&gt;顶层：应用服务层 (Application Layer)&lt;/b&gt;&#xa;对接远程云端服务器" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E1F5FE;strokeColor=#01579B;startSize=30;" parent="1" vertex="1">
          <mxGeometry x="160" y="80" width="480" height="100" as="geometry" />
        </mxCell>
        <mxCell id="app_protocols" value="标准云接口：MQTT / CoAP / HTTP / WebSocket" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#01579B;" parent="layer_app" vertex="1">
          <mxGeometry x="40" y="45" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="layer_mid" value="&lt;b&gt;中层：服务中间件层 (Service Middleware Layer)&lt;/b&gt;&#xa;负责协议映射与缓存管理" style="swimlane;whiteSpace=wrap;html=1;fillColor=#FFF9C4;strokeColor=#FBC02D;startSize=30;" parent="1" vertex="1">
          <mxGeometry x="160" y="210" width="480" height="180" as="geometry" />
        </mxCell>
        <mxCell id="mid_mapping" value="跨介质协议映射逻辑 (SDN控制平面)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#FBC02D;" parent="layer_mid" vertex="1">
          <mxGeometry x="40" y="50" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="mid_cache" value="双向异步缓存管理方案 (数据封装与分片)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#FBC02D;" parent="layer_mid" vertex="1">
          <mxGeometry x="40" y="110" width="400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="layer_phys" value="&lt;b&gt;底层：物理接入层 (Physical Access Layer)&lt;/b&gt;&#xa;兼容多模态异构链路" style="swimlane;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;startSize=30;" parent="1" vertex="1">
          <mxGeometry x="160" y="420" width="480" height="120" as="geometry" />
        </mxCell>
        <mxCell id="phys_underwater" value="水下接口：声学波形 / 激光脉冲" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82B366;" parent="layer_phys" vertex="1">
          <mxGeometry x="40" y="50" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="phys_air" value="空中接口：5G NR / 卫星射频" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#82B366;" parent="layer_phys" vertex="1">
          <mxGeometry x="260" y="50" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="sdn_tag" value="控制平面与数据平面分离" style="shape=curlyBracket;whiteSpace=wrap;html=1;rounded=1;flipH=1;labelPosition=right;verticalLabelPosition=middle;align=left;verticalAlign=middle;strokeWidth=2;strokeColor=#666666;" parent="1" vertex="1">
          <mxGeometry x="660" y="210" width="20" height="180" as="geometry" />
        </mxCell>
        <mxCell id="flow1" value="下行控制指令" style="endArrow=classic;html=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;strokeColor=#D32F2F;strokeWidth=2;" parent="1" source="layer_app" target="layer_mid" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow2" value="上行监测数据" style="endArrow=classic;html=1;exitX=0.75;exitY=0;exitDx=0;exitDy=0;entryX=0.75;entryY=1;entryDx=0;entryDy=0;strokeColor=#1976D2;strokeWidth=2;" parent="1" source="layer_mid" target="layer_app" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
        <mxCell id="flow3" style="endArrow=classic;startArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;strokeWidth=2;" parent="1" source="layer_mid" target="layer_phys" edge="1">
          <mxGeometry width="50" height="50" relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
