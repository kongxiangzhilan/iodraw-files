        <!-- ===== 步骤5 子过程 ===== -->

        <mxCell id="s5a" value="融合机会识别" style="rounded=1;fillColor=#FFFFFF;strokeColor=#D84315;" vertex="1" parent="1">
          <mxGeometry x="1580" y="280" width="260" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="s5b" value="核心节点与关键路径定位" style="rounded=1;fillColor=#FFFFFF;strokeColor=#D84315;" vertex="1" parent="1">
