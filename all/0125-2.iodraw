<mxfile host="app.diagrams.net">
  <diagram name="图2 跨领域技术融合机会挖掘方法流程（修正版）">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" page="1" pageWidth="1800" pageHeight="1000">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- ===== 主流程步骤 ===== -->

        <mxCell id="s1" value="步骤1&#10;数据解析" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E3F2FD;strokeColor=#1E88E5;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="60" y="120" width="260" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="s2" value="步骤2&#10;跨域技术关联抽取" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F5E9;strokeColor=#43A047;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="300" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="s3" value="步骤3&#10;理论溯源与情境梳理（含图谱构建）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFDE7;strokeColor=#F9A825;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="720" y="120" width="380" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="s4" value="步骤4&#10;融合机会演化建模与预测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E24AA;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1140" y="120" width="360" height="80" as="geometry"/>
        </mxCell>

        <mxCell id="s5" value="步骤5&#10;融合机会挖掘与输出" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FBE9E7;strokeColor=#D84315;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="1540" y="120" width="320" height="80" as="geometry"/>
        </mxCell>

        <!-- ===== 主流程箭头 ===== -->

        <mxCell id="e1" style="endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="s1" target="s2">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e2" style="endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="s2" target="s3">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e3" style="endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="s3" target="s4">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <mxCell id="e4" style="endArrow=classic;strokeWidth=2;" edge="1" parent="1" source="s4" target="s5">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ===== 步骤1 子过程 ===== -->

        <mxCell id="s1a" value="多源非结构化技术数据收集" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1E88E5;" vertex="1" parent="1">
          <mxGeometry x="80" y="240" width="240" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="s1b" value="数据清洗与标准化处理" style="rounded=1;fillColor=#FFFFFF;strokeColor=#1E88E5;" vertex="1" parent="1">
          <mxGeometry x="80" y="310" width="240" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== 步骤2 子过程 ===== -->

        <mxCell id="s2a" value="技术语义解析" style="rounded=1;fillColor=#FFFFFF;strokeColor=#43A047;" vertex="1" parent="1">
          <mxGeometry x="400" y="240" width="260" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="s2b" value="技术要素提取与三元组构建" style="rounded=1;fillColor=#FFFFFF;strokeColor=#43A047;" vertex="1" parent="1">
          <mxGeometry x="400" y="310" width="260" height="50" as="geometry"/>
        </mxCell>

        <mxCell id="s2c" value="关联关系初步分类" style="rounded=1;fillColor=#FFFFFF;strokeColor=#43A047;" vertex="1" parent="1">
          <mxGeometry x="400" y="380" width="260" height="50" as="geometry"/>
        </mxCell>

        <!-- ===== 步骤3 子过程 ===== -->

