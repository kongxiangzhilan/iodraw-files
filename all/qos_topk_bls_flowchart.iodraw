<mxfile host="www.iodraw.com" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/122.0.0.0 Safari/537.36 Edg/122.0.0.0" version="24.7.17">
  <diagram id="qos-topk-bls-flow" name="Page-1">
    <mxGraphModel dx="1424" dy="755" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="2400" math="1" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="开始" style="ellipse;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="485" y="20" width="150" height="52" as="geometry" />
        </mxCell>
        <mxCell id="3" value="输入：并发业务 &lt;i&gt;b&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt;–&lt;i&gt;b&lt;/i&gt;&lt;sub&gt;4&lt;/sub&gt;（2 Mbps、100 kbps、200 kbps、128 kbps）；&lt;div&gt;份额约束 Σα&lt;sub&gt;k&lt;/sub&gt; = 1，α&lt;sub&gt;k&lt;/sub&gt; ∈ [0.05, 0.60]；&lt;/div&gt;&lt;div&gt;8 条 QoS 门限与 2 条能耗门限&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="280" y="100" width="560" height="96" as="geometry" />
        </mxCell>
        <mxCell id="4" value="决策编码：下层 &lt;i&gt;u&lt;/i&gt; ∈ ℝ&lt;sup&gt;3&lt;/sup&gt; 经 α = &lt;i&gt;T&lt;/i&gt;(&lt;i&gt;u&lt;/i&gt;) 映射为 4 维业务份额；&lt;div&gt;上层共享向量 &lt;i&gt;s&lt;/i&gt; = (&lt;i&gt;P&lt;/i&gt;&lt;sub&gt;manet&lt;/sub&gt;, &lt;i&gt;T&lt;/i&gt;&lt;sub&gt;hello&lt;/sub&gt;, &lt;i&gt;P&lt;/i&gt;&lt;sub&gt;EIRP&lt;/sub&gt;&lt;sup&gt;gw&lt;/sup&gt;, &lt;i&gt;Q&lt;/i&gt;&lt;sub&gt;buf&lt;/sub&gt;&lt;sup&gt;gw&lt;/sup&gt;)&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="280" y="224" width="560" height="96" as="geometry" />
        </mxCell>
        <mxCell id="5" value="离线训练 RSM 代理模型：LHS 采样 + ns-3 仿真，拟合 D̄&lt;sub&gt;b&lt;/sub&gt;、L̄&lt;sub&gt;b&lt;/sub&gt; 与 σ&lt;sub&gt;D,b&lt;/sub&gt;、σ&lt;sub&gt;L,b&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="280" y="348" width="560" height="96" as="geometry" />
        </mxCell>
        <mxCell id="6" value="初始化：共享向量种群 &lt;i&gt;S&lt;/i&gt;；下层随机初始化 &lt;i&gt;K&lt;/i&gt; = 10 个候选解 &lt;i&gt;u&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="280" y="472" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="7" value="生成候选共享向量 &lt;i&gt;s&lt;/i&gt;（DE 变异/交叉）" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="280" y="570" width="560" height="60" as="geometry" />
        </mxCell>
        <mxCell id="9" value="RSM 评估 (&lt;i&gt;s&lt;/i&gt;, &lt;i&gt;u&lt;/i&gt;)：D̄&lt;sub&gt;b&lt;/sub&gt;、L̄&lt;sub&gt;b&lt;/sub&gt;、σ&lt;sub&gt;D,b&lt;/sub&gt;、σ&lt;sub&gt;L,b&lt;/sub&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="310" y="700" width="500" height="84" as="geometry" />
        </mxCell>
        <mxCell id="10" value="10 条硬约束是否全部满足？&lt;br&gt;（8 条鲁棒 QoS + 2 条能耗）" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="380" y="824" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="11" value="计算约束违反度&lt;br&gt;CV(&lt;i&gt;u&lt;/i&gt;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="135" y="844" width="165" height="96" as="geometry" />
        </mxCell>
        <mxCell id="12" value="计算约束感知步长&lt;br&gt;α = 1 + 2·max(0, CV(&lt;i&gt;u&lt;/i&gt;))" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="310" y="1000" width="500" height="76" as="geometry" />
        </mxCell>
        <mxCell id="13" value="基于 α 生成子代&lt;br&gt;û = DE(&lt;i&gt;u&lt;/i&gt;, α)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="310" y="1104" width="500" height="76" as="geometry" />
        </mxCell>
        <mxCell id="14" value="子代 RSM 评估：&lt;i&gt;f&lt;/i&gt;&lt;sub&gt;1&lt;/sub&gt;、&lt;i&gt;f&lt;/i&gt;&lt;sub&gt;2&lt;/sub&gt; 与 CV(û)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="310" y="1208" width="500" height="76" as="geometry" />
        </mxCell>
        <mxCell id="15" value="约束支配比较：可行解优先；可行解间按 Pareto 支配；&lt;div&gt;不可行解按 CV 升序&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="310" y="1312" width="500" height="84" as="geometry" />
        </mxCell>
        <mxCell id="16" value="可行优先 HSSP 环境选择：分层非支配排序 + HV 精英子集，保留 &lt;i&gt;K&lt;/i&gt; = 10" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="310" y="1424" width="500" height="84" as="geometry" />
        </mxCell>
        <mxCell id="17" value="达到下层评价预算？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="380" y="1580" width="360" height="124" as="geometry" />
        </mxCell>
        <mxCell id="18" value="输出下层 Top-10 候选集 &lt;i&gt;Q&lt;/i&gt;(&lt;i&gt;s&lt;/i&gt;)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="280" y="1760" width="560" height="70" as="geometry" />
        </mxCell>
        <mxCell id="19" value="计算适应度 &lt;i&gt;h&lt;/i&gt;(&lt;i&gt;s&lt;/i&gt;) = HV(&lt;i&gt;F&lt;/i&gt;(&lt;i&gt;Q&lt;/i&gt;(&lt;i&gt;s&lt;/i&gt;)), &lt;i&gt;r&lt;/i&gt;)&lt;br&gt;更新/接受共享向量种群 &lt;i&gt;S&lt;/i&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="280" y="1858" width="560" height="84" as="geometry" />
        </mxCell>
        <mxCell id="20" value="满足上层终止条件？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=15;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
          <mxGeometry x="380" y="1970" width="360" height="124" as="geometry" />
        </mxCell>
        <mxCell id="21" value="输出 Pareto 前沿与 Top-10 交付方案" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#000000;fontSize=16;fontFamily=SimSun;align=center;verticalAlign=middle;" parent="1" vertex="1">
